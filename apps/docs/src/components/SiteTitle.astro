---
// The uShelf wordmark, matching the web reader's brand: an italic serif "u" and a tight "Shelf".
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label="uShelf documentation home" translate="no">
  <span class="u">u</span>Shelf
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    color: var(--sl-color-white);
    font-size: 1.375rem;
    font-weight: 650;
    letter-spacing: -0.05em;
    text-decoration: none;
    white-space: nowrap;
  }
  .u {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-weight: 400;
  }
</style>
