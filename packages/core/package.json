{
  "name": "@ushelf/core",
  "version": "0.2.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "js-yaml": "^4.1.1",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^6.3.289",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.1",
    "undici": "^7.30.1",
    "unified": "^11.0.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^21.1.7",
    "@types/js-yaml": "^4.0.9",
    "@types/sanitize-html": "^2.16.0",
    "@types/turndown": "^5.0.5",
    "drizzle-kit": "^0.31.10"
  }
}
