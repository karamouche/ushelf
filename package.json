{
  "name": "ushelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ushelf/core build && concurrently -n api,web -c blue,white \"pnpm --filter @ushelf/server dev\" \"pnpm --filter @ushelf/web dev\"",
    "build": "pnpm --filter @ushelf/core build && pnpm --filter @ushelf/web build && pnpm --filter @ushelf/server build && pnpm --filter @ushelf/mcp build",
    "start": "pnpm --filter @ushelf/server start",
    "mcp": "pnpm --filter @ushelf/mcp start",
    "rebuild-index": "pnpm --filter @ushelf/server rebuild-index",
    "import": "pnpm --filter @ushelf/server import",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:skills": "python3 /Users/himbert/.codex/skills/.system/skill-creator/scripts/quick_validate.py skills/ushelf-ingest && python3 /Users/himbert/.codex/skills/.system/skill-creator/scripts/quick_validate.py skills/ushelf-library"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
