# USHELF_ROOT=/absolute/path/to/ushelf-home
USHELF_PORT=43110
USHELF_HOST=127.0.0.1
USHELF_WEB_BASE_PATH=/
# USHELF_APP_PASSWORD=choose-a-strong-password
# Docker Compose runs as these host IDs so it can read owner-only Kindle credentials.
# Set them to the output of `id -u` and `id -g` on the host.
# USHELF_UID=1000
# USHELF_GID=1000
